{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "wire-triggers": "node scripts/wire-cognito-triggers.mjs",
    "typecheck": "tsc --noEmit",
    "sam:validate": "sam validate --lint --config-env samtest",
    "sam:build": "sam build --config-env samtest",
    "sam:deploy:test": "sam build --config-env samtest && sam deploy --config-env samtest",
    "sam:wire:test": "cross-env STAGE=samtest AWS_REGION=us-east-1 STACK_NAME=schuit-sharing-samtest FUNCTION_PREFIX=schuit-sharing-samtest node scripts/wire-cognito-triggers.mjs",
    "sam:delete:test": "sam delete --config-env samtest"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "^3.600.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.600.0",
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/client-lambda": "^3.600.0",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/client-sesv2": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "esbuild": "^0.23.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.140",
    "@types/node": "^20.14.0",
    "cross-env": "^7.0.3",
    "typescript": "^5.4.0"
  }
}
