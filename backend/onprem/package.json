{
  "name": "backfriend-onprem",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Runs the Lambda handlers in ../src as one container, with Postgres, an OIDC provider and a filesystem in place of DynamoDB, Cognito and S3.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node build.mjs",
    "pretest": "node build.mjs --tests",
    "test": "node --test --test-concurrency=1 --test-timeout=120000 dist-test/*.test.mjs"
  },
  "dependencies": {
    "jose": "^5.9.6",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.140",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "@embedded-postgres/linux-x64": "^17.5.0-beta.15",
    "esbuild": "^0.23.0",
    "typescript": "^5.4.0"
  }
}
