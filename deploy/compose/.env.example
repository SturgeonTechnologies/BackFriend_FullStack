# Copy to .env (git-ignored), fill in the "you set" block, then run ./gen-secrets.sh.

# ----- You set these -----
SITE_HOST=sharing.example.com
BOOTSTRAP_ADMIN_EMAILS=you@example.com
# Holds data/ (the shared files) and config/<service>/. These must already exist.
# See docs/onprem/compose.md.
BACKFRIEND_DIR=/srv/backfriend
# Required: Keycloak emails address checks and password resets.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=noreply@example.com
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
# Same server, used by the app for invite emails: smtp://user:pass@host:587
SMTP_URL=

# ----- Optional -----
# Set to true only after running configure-optional.sh for that provider.
GOOGLE_ENABLED=false
FACEBOOK_ENABLED=false
# Owner of $BACKFRIEND_DIR/data, if it isn't 10001.
APP_UID=10001
APP_GID=10001

# ----- gen-secrets.sh appends POSTGRES_PASSWORD, APP_DB_PASSWORD, KEYCLOAK_DB_PASSWORD,
# ----- KEYCLOAK_ADMIN_PASSWORD and FILE_SIGNING_KEY here.
