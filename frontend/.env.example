# Copy to .env.local and fill in values printed by `serverless info`.
#
# IMPORTANT: this file is consumed by Vite at *build time*, so changing it
# requires a rebuild + redeploy (`npm run deploy`).
#
# ----- Production build (npm run deploy → s3://schuit-sharing/web/) -----
# Use these values when building the SPA that gets served at sharing.schuit.io.
# API calls are same-origin via CloudFront's /api/* behavior, which is the
# whole reason the CloudFront distribution exists; this avoids CORS entirely.
VITE_API_BASE=/api
VITE_REDIRECT_URI=https://sharing.schuit.io/auth/callback
VITE_LOGOUT_REDIRECT=https://sharing.schuit.io/

# ----- Local dev (npm run dev → http://localhost:5173) -----
# Hit the API Gateway directly. The backend's `httpApi.cors.allowedOrigins`
# for the `dev` stage already includes localhost:5173.
# VITE_API_BASE=https://xxxxxxxx.execute-api.us-east-1.amazonaws.com
# VITE_REDIRECT_URI=http://localhost:5173/auth/callback
# VITE_LOGOUT_REDIRECT=http://localhost:5173/

# ----- Always required (same value for dev and prod) -----
VITE_USER_POOL_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
VITE_COGNITO_DOMAIN=https://schuit-sharing-prod-123456789012.auth.us-east-1.amazoncognito.com

# ----- Branding (optional) -----
# Browser tab title. Defaults to "Schuit Sharing" (see vite.config.ts) if unset.
VITE_APP_TITLE=Schuit Sharing
